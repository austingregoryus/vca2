# SPDX-License-Identifier: MIT
[Unit]
Description=VCA node temperature, power and throttle logger (VCA2 monitor/)
After=network-online.target vca2-card.service
Wants=network-online.target

[Service]
EnvironmentFile=-/etc/vcamon.env
ExecStart=/usr/bin/python3 /opt/vcamon/vcamon.py run
Restart=always
RestartSec=10
Nice=10

[Install]
WantedBy=multi-user.target
