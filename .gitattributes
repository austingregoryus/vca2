# These scripts and sources are copied onto Linux hosts and onto the card's
# nodes. A CRLF checkout on Windows would ship them across with \r and break
# them ("bash: $'\r': command not found", or a kernel Makefile that silently
# does nothing). Force LF regardless of platform or core.autocrlf.
*.sh    text eol=lf
*.c     text eol=lf
*.h     text eol=lf
*.py    text eol=lf
*.md    text eol=lf
*.scad  text eol=lf
Makefile*   text eol=lf
Kbuild      text eol=lf
*.service  text eol=lf
*.conf     text eol=lf
*.patch    text eol=lf
*.json     text eol=lf
*.cff      text eol=lf
*.txt      text eol=lf
*.html     text eol=lf
*.csv      text eol=lf
*.log      text eol=lf
scripts/vca2-shutdown.sh text eol=lf

# Binary: never touch these.
*.stl   binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.pdf   binary
*.zip   binary
*.STEP  binary
